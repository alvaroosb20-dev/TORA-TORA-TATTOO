# Copia estas variables en Vercel → Project → Settings → Environment Variables.
# NUNCA las pongas en el código ni en site.config.mjs.

# --- Solicitudes de cita por correo (obligatorio para que el formulario funcione) ---
RESEND_API_KEY=            # resend.com → API Keys
RESERVAS_EMAIL_TO=         # correo del estudio que recibe las solicitudes
RESERVAS_EMAIL_FROM=       # remitente de un dominio verificado en Resend, p. ej. "Web Tora Tora <reservas@tudominio.es>"
SEND_CLIENT_COPY=false     # true = el cliente recibe un acuse de recibo (requiere dominio verificado)

# --- Señal online con Stripe (opcional, solo si el estudio lo pide) ---
STRIPE_SECRET_KEY=         # sk_live_... (o sk_test_... para pruebas)
DEPOSIT_AMOUNT_EUR=        # importe de la señal en euros, p. ej. 50
SITE_URL=                  # https://tudominio.es (para volver de Stripe)

# --- Reseñas reales de Google (Places API New) ---
GOOGLE_PLACES_API_KEY=     # console.cloud.google.com → activar "Places API (New)" → Credenciales → clave restringida a esa API
GOOGLE_PLACE_ID=           # opcional; si se deja vacío se busca solo (aparece en los logs de Vercel para fijarlo aquí)
